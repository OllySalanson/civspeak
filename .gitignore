# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Never commit game data, the built index or secrets.
# The index lives in ~/.local/share/civspeak (%LOCALAPPDATA%\Civspeak on Windows) and the key in
# ~/.config/civspeak, but guard against stray copies too.
*.sqlite
*.sqlite.part
*.sqlite3
*.db
*.modinfo
*.blp
*.dds
*.xml
*.sql
*.log
*.wav
*.mp3
*.ogg
*.webm
*.flac
# Voice models (Kokoro, Whisper) stay in ~/.local/share and ~/.cache/huggingface.
*.onnx
*.bin
anthropic-key
*.key
.env
spend.jsonl

# Local tooling
.lavish/
.claude/
